# Database
# - Username. Default
QUARKUS_DATASOURCE_USERNAME=healthcare-user
# - Password. Default
QUARKUS_DATASOURCE_PASSWORD=healthcare-password
# - Url. String connection structure: vertx-reactive:postgresql://<hostname>:<port>/<database>. Default
QUARKUS_DATASOURCE_REACTIVE_URL=vertx-reactive:postgresql://host.docker.internal:5432/healthcare-db?loggerLevel=OFF

# Redis
# - Url. String connection structure: redis://<hostname>:<port>. Default
QUARKUS_REDIS_HOSTS=redis://host.docker.internal:6379
