// See https://go.microsoft.com/fwlink/?LinkId=733558
// for the documentation about the tasks.json format
{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell",
      "group": "build",
      "label": "appointment:dev",
      "isBackground": true,
      "problemMatcher": [
        {
          "pattern": [
            {
              "regexp": "\\[(\\d+)\\]\\s(.*):(\\d+):(\\d+)\\s\\-\\s{(.*)}:\\s(.*)$",
              "file": 2,
              "line": 3,
              "column": 4,
              "message": 6
            }
          ],
          "background": {
            "activeOnStart": true,
            "beginsPattern": "^.*Scanning for projects...",
            "endsPattern": "(^.*Quarkus .* started in .*\\.)|(^.* ERROR .* Failed to start)"
          }
        }
      ],
      "command": "./mvnw -f services/appointment/pom.xml quarkus:dev",
      "windows": {
        "command": ".\\mvnw.cmd -f services/appointment/pom.xml quarkus:dev"
      }
    },
    {
      "type": "shell",
      "group": "build",
      "label": "ehr:dev",
      "isBackground": true,
      "problemMatcher": [
        {
          "pattern": [
            {
