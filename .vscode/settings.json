{
  // Spell checker
  "cSpell.words": [
    "Cayetano",
    "elysia",
    "elysiajs",
    "Heredia",
    "nanostores",
    "sonner",
    "Umami"
  ],

  // Javascript
  "javascript.preferences.importModuleSpecifier": "non-relative",
  "typescript.preferences.importModuleSpecifier": "non-relative",

  // Tailwindcss
  "files.associations": {
    "*.css": "tailwindcss"
  },
  "tailwindCSS.classFunctions": [
    "tw",
    "twi",
    "twj",
    "tv",
    "cn",
    "clsx",
    "twMerge",
    "cva"
  ],
  "tailwindCSS.experimental.classRegex": [
    // Includ spread operator for twj
    "\\.\\.\\.\\s*twj`([\\s\\S]*?)`"
  ],
  "tailwindCSS.classAttributes": [
    "class=*",
    "class:list=*",
    ".*Classname(s?)*",
    ".*Classname(s?): .*"
  ],

  // MicroProfile
  "microprofile.tools.validation.unknown.excluded": [
    "*/mp-rest/providers/*/priority",
    "mp.openapi.schema.*",
    "kafka-streams.*",
    "camel.*",
    "mp.openapi.extensions.smallrye.property-naming-strategy"
  ],

  // Yaml
  "yaml.schemas": {
    "microprofile://schema/file:///Users/alexr/dev/cloud-native-healthcare-platform/services/appointment/src/main/resources/application.yml": "file:///Users/alexr/dev/cloud-native-healthcare-platform/services/appointment/src/main/resources/application.yml"
  },
  "java.compile.nullAnalysis.mode": "automatic",
  "chat.tools.terminal.autoApprove": {
    "/^\\$src=\"\\$HOME\\\\\\.m2\\\\repository\\\\io\\\\quarkus\\\\quarkus-hibernate-reactive-rest-data-panache\\\\3\\.32\\.1\\\\quarkus-hibernate-reactive-rest-data-panache-3\\.32\\.1-sources\\.jar\"; Add-Type -AssemblyName System\\.IO\\.Compression\\.FileSystem; \\$zip=\\[System\\.IO\\.Compression\\.ZipFile\\]::OpenRead\\(\\$src\\); \\$entry=\\$zip\\.Entries \\| Where-Object \\{ \\$_\\.FullName -like '\\*PanacheEntityResource\\.java' \\} \\| Select-Object -First 1; \\$reader=New-Object System\\.IO\\.StreamReader\\(\\$entry\\.Open\\(\\)\\); \\$content=\\$reader\\.ReadToEnd\\(\\); \\$reader\\.Close\\(\\); \\$zip\\.Dispose\\(\\); \\$content$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "/^\\$src=\"\\$HOME\\\\\\.m2\\\\repository\\\\io\\\\quarkus\\\\quarkus-rest-data-panache\\\\3\\.32\\.1\\\\quarkus-rest-data-panache-3\\.32\\.1-sources\\.jar\"; Add-Type -AssemblyName System\\.IO\\.Compression\\.FileSystem; \\$zip=\\[System\\.IO\\.Compression\\.ZipFile\\]::OpenRead\\(\\$src\\); \\$entry=\\$zip\\.Entries \\| Where-Object \\{ \\$_\\.FullName -like '\\*ReactiveRestDataResource\\.java' \\} \\| Select-Object -First 1; \\$reader=New-Object System\\.IO\\.StreamReader\\(\\$entry\\.Open\\(\\)\\); \\$content=\\$reader\\.ReadToEnd\\(\\); \\$reader\\.Close\\(\\); \\$zip\\.Dispose\\(\\); \\$content$/": {
